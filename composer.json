{
    "name": "algebrakit/sdk-php",
    "description": "Official PHP SDK for the Algebrakit API: create exercise sessions, get scores and session info, lock sessions and validate exercises.",
    "type": "library",
    "keywords": [
        "algebrakit",
        "sdk",
        "api-client",
        "math",
        "education",
        "edtech",
        "exercises"
    ],
    "homepage": "https://github.com/algebrakit/sdk-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Algebrakit",
            "homepage": "https://www.algebrakit.com"
        }
    ],
    "support": {
        "issues": "https://github.com/algebrakit/sdk-php/issues",
        "source": "https://github.com/algebrakit/sdk-php",
        "docs": "https://docs.algebrakit.com/pages/320-SDK/"
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Algebrakit\\SDK\\": "src/"
        },
        "classmap": [
            "src/Models/AkExercise/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Algebrakit\\SDK\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "demo": "php demo/tour.php"
    }
}
